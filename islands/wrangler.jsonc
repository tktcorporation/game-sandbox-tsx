{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // RINGFALL's islands: one Durable Object for each island (worker/island-do.ts). The game's Worker
  // (../wrangler.jsonc) binds to `IslandDO` here by `script_name`; deploy this Worker first.
  "name": "ringfall-islands",
  "main": "./index.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [{ "name": "ISLAND", "class_name": "IslandDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IslandDO"] }],
  "observability": {
    "enabled": true
  }
}
