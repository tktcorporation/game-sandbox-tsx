{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-sandbox-tsx",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
